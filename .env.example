# =============================================================================
# AdReel AI - environment configuration
# =============================================================================
# Copy to `.env.local`. EVERY value below is optional: with an empty file the
# app boots in DEMO MODE (local file store, cookie auth, mock AI providers,
# real Remotion rendering). See docs/PROVIDERS.md for details.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public base URL, used for absolute media URLs handed to the renderer.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign demo-mode session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A development-only fallback is used when unset.
AUTH_SECRET=

# Force demo mode even when provider keys are present ("1" | "true").
ADREEL_FORCE_DEMO=

# Directory for the demo-mode JSON store (default: <repo>/.adreel)
ADREEL_DATA_DIR=

# -----------------------------------------------------------------------------
# Supabase (auth + postgres + storage). Leave blank to use the demo store.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used by background jobs that must
# bypass RLS (they re-check ownership in application code before every write).
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for user uploads and rendered videos.
SUPABASE_STORAGE_BUCKET=adreel-media

# -----------------------------------------------------------------------------
# Provider selection. Each defaults to "mock".
# -----------------------------------------------------------------------------
# text:    mock | openai | anthropic
# image:   mock | openai | replicate
# video:   mock | replicate
# voice:   mock | elevenlabs
# music:   mock | library
# render:  remotion | mock
# storage: local | supabase
ADREEL_TEXT_PROVIDER=mock
ADREEL_IMAGE_PROVIDER=mock
ADREEL_VIDEO_PROVIDER=mock
ADREEL_VOICE_PROVIDER=mock
ADREEL_MUSIC_PROVIDER=mock
ADREEL_RENDER_PROVIDER=remotion
ADREEL_STORAGE_PROVIDER=local

# -----------------------------------------------------------------------------
# Provider credentials (server-only - never prefix these with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
# claude-opus-5 (Standard) | claude-sonnet-5 (guenstiger) | claude-haiku-4-5
ANTHROPIC_TEXT_MODEL=claude-opus-5
# Optional: low | medium | high | xhigh | max. Leer = Standard des Modells.
# Niedrigere Stufen senken die Kosten pro Generierung deutlich.
ANTHROPIC_EFFORT=
ANTHROPIC_BASE_URL=https://api.anthropic.com

REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_VIDEO_MODEL=minimax/video-01

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# -----------------------------------------------------------------------------
# Provider execution tuning (shared by every adapter)
# -----------------------------------------------------------------------------
ADREEL_PROVIDER_TIMEOUT_MS=120000
ADREEL_PROVIDER_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Rendering
# -----------------------------------------------------------------------------
# Absolute path to a Chrome/Chromium binary for Remotion. When unset, Remotion
# downloads its own Chrome Headless Shell on first render.
REMOTION_BROWSER_EXECUTABLE=
# Parallel rendering threads. Leave blank for Remotion's default.
REMOTION_CONCURRENCY=

# -----------------------------------------------------------------------------
# Rate limiting (in-memory fixed window)
# -----------------------------------------------------------------------------
ADREEL_RATE_LIMIT_GENERATION_PER_MIN=10
ADREEL_RATE_LIMIT_UPLOAD_PER_MIN=30
ADREEL_RATE_LIMIT_AUTH_PER_MIN=10
